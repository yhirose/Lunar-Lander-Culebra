# Lunar Lander, a Culebra port of aayala4's Lunar-Lander-Python
# (github.com/aayala4/Lunar-Lander-Python), GPL-3.0. See LICENSE.
#
# The original runs on pgzero (Pygame Zero). This port keeps its 1400x800
# playfield, its physics constants, its terrain generator and its scoring, and
# replaces pgzero with Culebra's Canvas: pgzero's draw/update pair becomes one
# `Canvas.run` tick, its `keyboard.<key>` polling becomes `Canvas.key`, and its
# `clock.schedule` callbacks become a frame deadline (see `schedule`).
#
#   culebra lunar_lander.cul            # play
#   culebra --jit lunar_lander.cul      # the same, JIT-compiled
#   culebra lunar_lander.cul demo 1200  # autopilot; writes shot.png of the
#                                       # last frame, for a machine with no
#                                       # display (CULEBRA_CANVAS_HEADLESS=1)
#
# Left/Right rotate, Up/Down work the throttle, D hands the controls to the
# autopilot and takes them back, Q returns to the menu. From the title screen,
# D starts a round the autopilot flies, and Q asks to confirm before quitting
# (native only -- there is no "quit" on the web, so the Playground build never
# offers it).

import lander from './ship.cul'
import land from './terrain.cul'

let WIDTH = 1400
let HEIGHT = 800
let PI = 3.1415926
let DT = 1.0 / 60.0  # pgzero passed the real frame time; Canvas is vsynced
let GRAVITY = 10.0 * DT  # the fall the thrust has to cancel, per frame

let UPRIGHT = -PI / 2.0  # the hull angle that puts both feet underneath

let WHITE = Canvas.rgba(255, 255, 255)
let BLACK = Canvas.rgba(0, 0, 0)

let DEMO = Sys.argv.get(0, "") == "demo"

let START_GAS = 750.0
let CRASH_COST = 100.0
let LANDING_BONUS = 50.0

let assets = Embed.dir("assets")
let explosion = Canvas.Sound.new(assets.read("explosion.ogg"))
let thrust = assets.read("rocket_thrust.ogg")

# The original asked the player to fetch the `dylova` TTF themselves, which is
# freeware the designer does not license for redistribution, so it cannot ride
# along in a GPL-3.0 repository. Nova Square is the closest OFL face: the same
# squared-off sci-fi skeleton without dylova's diagonal slashes through the
# stems. See assets/NovaSquare-OFL.txt.
let FONT = Canvas.Font(assets.read("NovaSquare.ttf"))

# The original's own point sizes, which a TTF takes directly. Its HUD rows sat
# at y = 40, 60, 80, and pgzero's default line height for a 24 px block is 24;
# a little more air suits Nova Square's tall caps.
let HUD = 20
let TEXT = 24
let TITLE = 80
let HUD_LINE = 20
let LINE = 30

# `draw_screen` rasterizes at the size the frame is presented at rather than
# into the 1400x800 framebuffer, so the HUD stays sharp in a Playground pane
# that shows it at about 1000 px wide instead of being resampled with the
# nearest-neighbour scaling the rest of the frame wants. It composites over
# the frame rather than into it, though, and `Canvas.to_png` reads the
# framebuffer: the demo would write a shot.png with no text on it at all, so
# that run draws into the frame instead.
let text = fn (s, x, y, size) {
  if DEMO {
    FONT.draw(s, x, y, WHITE, size)
  } else {
    FONT.draw_screen(s, x, y, WHITE, size)
  }
}

let CONTROLS = [
  "Controls:",
  "Left and Right Arrows: Rotate Ship",
  "Up and Down Arrows: Strengthen/Weaken Thrusters",
  "D: Demo Mode On/Off (the autopilot flies)",
  "Q: Quit game",
]
let CRASHED = ["YOU CRASHED", "YOU LOST 100 FUEL UNITS"]
let GOOD_LANDING = ["GOOD LANDING", "50 FUEL UNITS ADDED"]
let HARD_LANDING = ["HARD LANDING"]
let NO_FUEL = ["YOU RAN OUT OF FUEL", "GAME OVER"]
let QUIT_CONFIRM = ["QUIT?", "Q: yes     P: no"]
let MENU_CONFIRM = ["BACK TO TITLE?", "Q: yes     P: no"]

# The two HUD columns are inset from their own edge by the same margin. The
# original padded one string with spaces and let the font land the value where
# it fell; a proportional face needs the widths measured, so each column is a
# box wide enough for its longest row and the value is placed inside it.
let HUD_MARGIN = 40
let LEFT_HUD_X = HUD_MARGIN
let LEFT_VALUE_DX = FONT.text_width("SCORE    ", HUD)  # the original's own padding
let RIGHT_HUD_W = FONT.text_width("HORIZONTAL SPEED     000", HUD)
let RIGHT_HUD_X = WIDTH - HUD_MARGIN - RIGHT_HUD_W

# Centred on `cx` rather than on the screen, so the same helper serves the
# menu and the pad labels the terrain draws at arbitrary x.
let text_at = fn (s, cx, y, size) {
  text(s, cx - FONT.text_width(s, size) / 2, y, size)
}

let text_centered = fn (s, y, size) {
  text_at(s, WIDTH / 2, y, size)
}

# A column of label/value readouts, labels flush left. `value_dx` places the
# values: a positive offset is their left edge, and `width` right-aligns them
# against the far side of a column that wide instead.
let stats = fn (x, rows, value_dx = 0, width = 0) {
  for i, (label, value) in rows.enumerate() {
    let y = 40 + i * HUD_LINE
    text(label, x, y, HUD)
    let v = "{value}"
    let vx = width > 0 ? x + width - FONT.text_width(v, HUD) : x + value_dx
    text(v, vx, y, HUD)
  }
}

let block_centered = fn (lines, y, size) {
  for i, line in lines.enumerate() {
    text_centered(line, y + i * LINE, size)
  }
}

# 1D value noise, for the menu ship's hover (below): plain sines drift
# forever in lockstep and eventually repeat exactly, which reads as
# mechanical once you watch it a while. This wanders instead. `seed` gives
# each animated channel (x, y, angle, throttle) its own uncorrelated stream
# out of the same noise; `x` is time, scaled by the caller to taste.
#
# noise_hash hashes lattice point `i` to a pseudo-random float in [-1, 1)
# with the classic sin-of-a-large-number trick: sin() at these magnitudes is
# effectively uncorrelated with `i`, and only the fractional part of the
# result is kept, so consecutive integers hash to unrelated values.
let noise_hash = fn (seed, i) {
  let n = to_float(i) * 12.9898 + to_float(seed) * 78.233
  let s = Math.sin(n) * 43758.5453
  (s - to_float(Math.floor(s))) * 2.0 - 1.0
}

# noise1d interpolates between the hashes at the two lattice points either
# side of `x` with smootherstep easing (6t^5 - 15t^4 + 10t^3), so the
# result is continuous and flat-tangent at each lattice point instead of
# kinking there the way a linear blend would.
let noise1d = fn (seed, x) {
  let i0 = Math.floor(x)
  let f = x - to_float(i0)
  let a = noise_hash(seed, i0)
  let b = noise_hash(seed, i0 + 1)
  let t = f * f * f * (f * (f * 6.0 - 15.0) + 10.0)
  a + (b - a) * t
}

# Where the menu's idle ship hovers, and how far: a slow drift and bob under
# the Controls block, well clear of the text now that draw_menu keeps that
# block centered on HEIGHT / 2.
let MENU_SHIP_Y = HEIGHT - 140.0
let MENU_SHIP_DRIFT = 46.0
let MENU_SHIP_BOB = 16.0
let MENU_SHIP_TILT = 0.16

enum Mode {
  Menu,
  Playing,
  Over,
}

# How the last touchdown was judged.
enum Landing {
  Good,
  Hard,
  TooFast,
}

# What the pending deadline does when it comes due, carrying the frame it is
# due on -- a payload variant instead of a hand-paired (Timer, due) tuple.
enum Timer {
  NextLife(Long),
  ToMenu(Long),
}

class Game {
  ship = lander.Ship()
  menu_ship = lander.Ship()  # idles on the title screen; never enters play
  terrain = land.Terrain(WIDTH, HEIGHT)
  mode = Mode.Menu
  score = 0
  multiplier = 1
  collided = lander.Hit.Clear
  landing: Landing  # only meaningful once a touchdown has set it
  playing = true
  thrusting = false
  fc = 0
  # This frame's key presses. Canvas.key reports what is held right now, which
  # is right for the throttle and the rotation but loses a tap whose press and
  # release both fall between two frames. Starting a round and leaving one are
  # single presses, so they read the edge queue instead.
  pressed = []
  pending = nil  # a Timer variant carrying the frame it is due, or nil
  demo = false
  confirming_quit = false  # showing "Quit?" over the title screen
  confirming_menu = false  # showing "Back to title?" over the round in play

  new(demo) {
    self.demo = demo
  }

  start_game() {
    self.mode = Mode.Playing
    self.score = 0
    self.ship.set_gas(START_GAS)
    self.next_life()
  }

  # A new life on the same tank of fuel, over freshly generated ground.
  next_life() {
    self.ship.spawn()
    self.terrain.generate()
    self.collided = lander.Hit.Clear
    self.multiplier = 1
    self.playing = true
  }

  to_menu() {
    self.mode = Mode.Menu
    self.pending = nil
    # A demo the player asked for with D lasts as long as the round does; the
    # title screen goes back to whatever the command line asked for.
    self.demo = DEMO
  }

  out_of_fuel() {
    self.mode = Mode.Over
    self.playing = false
  }

  # pgzero scheduled the between-lives pauses with clock.schedule; against a
  # vsynced loop a frame deadline does the same job. Only one can be pending,
  # which is what the original's resetScheduled flag enforced. The callers are
  # the draw_* methods rather than the transitions, because the mode being
  # drawn is what decides which timer to arm: a crash that also empties the
  # tank runs crashed() and out_of_fuel() on the same frame, and it is the
  # game-over return that has to win.
  schedule(make_timer, seconds) {
    let due = self.fc + Math.round(seconds * 60.0)
    self.pending = make_timer(due) if self.pending == nil
  }

  fire_due() {
    match self.pending {
      NextLife(due) if self.fc >= due => {
        self.pending = nil
        self.next_life()
      },
      ToMenu(due) if self.fc >= due => {
        self.pending = nil
        self.to_menu()
      },
      _ => nil,
    }
  }

  tick() {
    self.fc += 1
    # Drained here and nowhere else: the queue empties as it is read.
    self.pressed = Canvas.key_queue()
    # F, from any screen, mirrors the browser build's own F key and Y/Start
    # gamepad mapping (docs/index.html) -- both routes into the one native
    # Canvas.toggle_fullscreen() this repo's culebra checkout now carries.
    if self.pressed.contains("f") || Canvas.pad_pressed(Canvas.PAD_Y) ||
        Canvas.pad_pressed(Canvas.PAD_START) {
      Canvas.toggle_fullscreen()
    }
    self.fire_due()
    match self.mode {
      m: Menu => {
        self.animate_menu_ship()
        if self.confirming_quit {
          self.quit_menu()
        } else if self.demo_pressed() {
          # D from here starts the round with the autopilot already flying,
          # rather than arming something P then has to collect.
          self.demo = true
          self.start_game()
        } else {
          # The demo lingers on the title screen, then presses P itself.
          self.start_game() if self.pressed.contains("p") ||
            Canvas.pad_pressed(Canvas.PAD_A) || self.demo && self.fc > 60
          # can_quit() is false on the web (no window to close), so Q there
          # keeps meaning nothing from the title screen, same as today.
          self.confirming_quit = true if (self.pressed.contains("q") ||
            Canvas.pad_pressed(Canvas.PAD_B)) && Canvas.can_quit()
        }
      },
      m: Playing => {
        if self.confirming_menu {
          self.confirm_menu()
        } else {
          # Outside controls(), which never runs while the autopilot has the
          # controls -- and its one-key-a-frame rule is the pilot's, not this.
          self.demo = !self.demo if self.demo_pressed()
          self.update_play()
        }
      },
      m: Over => nil,
    }
    self.sync_thrust()
    self.draw()
    true
  }

  # Left stick or D-pad, past the same deadzone the browser build's JS uses
  # for the same two directions.
  pad_left() {
    Canvas.pad_held(Canvas.PAD_LEFT) || Canvas.pad_axis(Canvas.AXIS_LX) < -0.5
  }
  pad_right() {
    Canvas.pad_held(Canvas.PAD_RIGHT) || Canvas.pad_axis(Canvas.AXIS_LX) > 0.5
  }

  # D, or X on a pad -- the one face button the rest of the vocabulary leaves
  # free. A press, not a state, so it reads the same edge queue P and Q do.
  demo_pressed() {
    self.pressed.contains("d") || Canvas.pad_pressed(Canvas.PAD_X)
  }

  # Q, or B on a pad. Read by both pilots: leaving a round is the watcher's
  # call even while the autopilot is flying it.
  quit_pressed() {
    self.pressed.contains("q") || Canvas.pad_pressed(Canvas.PAD_B)
  }

  # Q again quits outright; P backs out -- both reuse the meaning they
  # already carry elsewhere (Q leaves, P proceeds) rather than teaching a
  # new key just for this prompt.
  quit_menu() {
    cond {
      self.pressed.contains("q") || Canvas.pad_pressed(Canvas.PAD_B) => Canvas.quit(),
      self.pressed.contains("p") || Canvas.pad_pressed(Canvas.PAD_A) =>
        self.confirming_quit = false,
      _ => nil,
    }
  }

  # Same shape as quit_menu(), for the "back to the title screen" prompt a
  # round in progress shows instead of just leaving outright.
  confirm_menu() {
    cond {
      self.pressed.contains("q") || Canvas.pad_pressed(Canvas.PAD_B) => {
        self.confirming_menu = false
        self.to_menu()
      },
      self.pressed.contains("p") || Canvas.pad_pressed(Canvas.PAD_A) =>
        self.confirming_menu = false,
      _ => nil,
    }
  }

  update_play() {
    return if !self.playing
    let s = self.ship

    s.y += s.yvel * DT + 0.5 * 30.0 * DT * DT
    s.x += s.xvel * DT

    # Off one edge of the screen and back in on the other.
    s.x = cond {
      s.x > WIDTH + 10 => -10.0,
      s.x < -10 => to_float(WIDTH + 10),
      _ => s.x,
    }

    # Too high to be flying: back to the spawn point.
    s.spawn() if s.y < -50.0

    s.xvel = Math.clamp(s.xvel, -100.0, 100.0)
    s.yvel += GRAVITY
    s.accelerate()

    if self.demo {
      self.autopilot()
      self.confirming_menu = true if self.quit_pressed()
    } else {
      self.controls()
    }
    return if self.mode != Mode.Playing

    s.hitbox()
    self.collided = s.collision(self.terrain)
    match self.collided {
      h: Crash => self.crashed(),
      h: Touchdown => self.touched_down(),
      _ => nil,
    }

    self.out_of_fuel() if s.gas <= 0.0
  }

  # One key acts per frame, in the original's order of precedence. Q sits last
  # and reads a queue that tick() has already drained, so a Q tapped while an
  # arrow is held is dropped rather than deferred to the next frame the way the
  # held-state read it replaced would have been. Pressing it again works.
  #
  # hjkl doubles the arrows the way WASD already doubles them natively (see
  # canvas.cul's KEY_BITS) -- a second d-pad for whichever hand is on the
  # letters. Named keys read straight off the keyboard here, unlike the
  # browser build, where hjkl only exists as a page-side rewrite onto the
  # arrows because the Playground it embeds has no idea what an "h" means.
  controls() {
    let s = self.ship
    cond {
      Canvas.key("left") || Canvas.key("h") || self.pad_left() =>
        s.rotate(s.ang - PI / 14.0),
      Canvas.key("right") || Canvas.key("l") || self.pad_right() =>
        s.rotate(s.ang + PI / 14.0),
      Canvas.key("down") || Canvas.key("j") || Canvas.pad_held(Canvas.PAD_LB) =>
        s.throttle_by(-1),
      Canvas.key("up") || Canvas.key("k") || Canvas.pad_held(Canvas.PAD_RB) =>
        s.throttle_by(1),
      self.quit_pressed() => self.confirming_menu = true,
      _ => nil,
    }
  }

  # The screen wraps, so the short way to a target may be off one edge and
  # back in on the other.
  wrapped_dx(tx) {
    let dx = tx - self.ship.x
    cond {
      dx > WIDTH / 2.0 => dx - WIDTH,
      dx < -WIDTH / 2.0 => dx + WIDTH,
      _ => dx,
    }
  }

  # The pad the demo flies to: the one nearest where a life starts, taking
  # the wider of two that are about as close, since both feet have to come
  # down on the same flat and the narrowest pad is 22 px against an 11 px
  # stance. Measured from the spawn column rather than from the ship, so it
  # stays the same pad for the whole life -- read off the live position it
  # re-picks as the ship crosses the field, and the ship chases the switch
  # back and forth. Nil where the terrain placed no pad at all.
  demo_pad() {
    mut best = nil
    for spot in self.terrain.spots {
      let (x1, x2) = self.terrain.span(spot)
      let pad = {cx: (x1 + x2) / 2.0, w: x2 - x1,
                 d: Math.abs((x1 + x2) / 2.0 - lander.SPAWN_X)}
      best = pad if best == nil || pad.d < best.d - 120.0 ||
        pad.d < best.d + 120.0 && pad.w > best.w
    }
    best
  }

  # Enough of a pilot to fly the demo: pick a pad, then fly the hull as a
  # thrust vector -- work out the acceleration that would close the speed
  # error on both axes, and solve back for the one attitude and throttle that
  # deliver it. The hull only pushes along its own axis, so steering and
  # holding altitude are the same control and cannot be run as a separate
  # "tilt for x, throttle for y" pair: that pair brakes with the throttle at
  # 0, which is no horizontal authority at all. One action per frame, like the
  # keyboard. It reads the ship rather than remembering anything, so D can
  # hand it a hull mid-flight in whatever attitude the player left it in.
  autopilot() {
    let s = self.ship
    let step = PI / 14.0
    let pad = self.demo_pad()
    let dx = pad == nil ? 0.0 : self.wrapped_dx(pad.cx)
    # Clearance over the ground actually below the ship, not the HUD's
    # altitude, because the terrain has peaks to fly into.
    let ground = self.terrain.top_near(Math.round(s.x)) ?? HEIGHT
    let clearance = to_float(ground) - s.y

    # Cross at a speed that eases as the pad comes up, so the drift is already
    # gone on arrival rather than being braked over it.
    let want_xvel = Math.clamp(dx * 0.3, -90.0, 90.0)
    # Both feet have to reach the ground on the same frame, so the descent
    # waits until the pad is underneath and the drift is out; below 90 px it
    # is too late to go around and it rides down whatever it looks like.
    let lined_up = Math.abs(dx) < 5.0 && Math.abs(s.xvel) < 1.5
    let want_yvel = clearance < 90.0 || lined_up
      ? Math.clamp(clearance * 0.45, 8.0, 70.0)
      : Math.clamp((clearance - 170.0) * 0.3, -15.0, 70.0)

    # The thrust that closes both errors, in throttle units along each axis
    # (`accelerate` scales them apart), with gravity to cancel on top of the
    # vertical one. Only the upper half turn is reachable, so a demand to fall
    # faster than gravity is simply no thrust rather than a downward push.
    let tx = Math.clamp((want_xvel - s.xvel) * 0.08, -0.45, 0.45) / lander.THRUST_X
    let ty = Math.min((want_yvel - s.yvel) * 0.08 - GRAVITY, 0.0) / lander.THRUST_Y
    # Level for the last stretch whatever the drift is doing: a hull still
    # tilted puts one leg down first, which the collision test reads as a
    # crash rather than as a landing.
    let flare = clearance < 22.0
    let mag = flare ? Math.abs(ty) : Math.sqrt(tx * tx + ty * ty)
    let want_throttle = Math.clamp(Math.round(mag), 0, 8)
    # atan2 answers +PI for a purely leftward push, which is the same heading
    # as -PI; the hull only turns through the negative half. With no thrust
    # wanted at all the heading is meaningless and answers sideways, so hold
    # the hull level instead: the rotation arms below come first, and a hull
    # chasing a meaningless heading never gets a frame back to the throttle --
    # which then stays where it was and flies the ship away from the pad.
    let dir = Math.atan2(ty, tx)
    let want_ang = flare || want_throttle == 0 ? UPRIGHT : (dir > 0.0 ? -PI : dir)

    # The hull turns a step at a time and the throttle moves a notch at a
    # time, so the deadband is half a step: `want_ang` is a continuous
    # heading, and the reachable angles sit a step apart.
    cond {
      s.ang - want_ang > step / 2.0 => s.rotate(s.ang - step),
      want_ang - s.ang > step / 2.0 => s.rotate(s.ang + step),
      s.throttle < want_throttle => s.throttle_by(1),
      s.throttle > want_throttle => s.throttle_by(-1),
      _ => nil,
    }
  }

  crashed() {
    self.playing = false
    self.score += 5
    self.ship.set_gas(self.ship.gas - CRASH_COST)
    explosion.play()
  }

  # Both feet are on the ground. Whether that counts as a landing is down to
  # how fast the ship was still moving.
  touched_down() {
    let s = self.ship
    self.playing = false
    self.multiplier = self.terrain.multiplier_at(s.x)
    # hitbox()'s feet sit at collision's own FOOT radius (11, ship.cul), one
    # unit short of LEG_END (12) where the legs are actually drawn, and the
    # discrete step that reached "both feet down" at all has usually carried
    # the ship a further pixel or more past that -- both together read as
    # the legs sinking into the ground for the four seconds the landing
    # message is up. Settle the hull up by however far the deeper drawn leg
    # tip penetrated, so both come to rest exactly on the surface instead.
    # (Left uncorrected, this is the original Python port's own look too --
    # pgzero's tick checked "past the line" the same way, no settling.)
    let tip1 = s.at(lander.LEG_END, s.ang + lander.LEG_SPREAD)
    let tip2 = s.at(lander.LEG_END, s.ang - lander.LEG_SPREAD)
    let sink = Math.max(
      tip1.y - to_float(self.terrain.top_near(Math.round(tip1.x)) ?? Math.round(tip1.y)),
      tip2.y - to_float(self.terrain.top_near(Math.round(tip2.x)) ?? Math.round(tip2.y)),
    )
    s.y -= sink if sink > 0.0
    cond {
      s.yvel < 12.0 && Math.abs(s.xvel) < 25.0 => {
        self.landing = Landing.Good
        s.set_gas(s.gas + LANDING_BONUS)
        self.score += self.multiplier * 50
      },
      s.yvel < 25.0 && Math.abs(s.xvel) < 25.0 => {
        self.landing = Landing.Hard
        self.score += self.multiplier * 15
      },
      _ => {
        self.landing = Landing.TooFast
        self.score += 5
        s.set_gas(s.gas - CRASH_COST)
        explosion.play()
      },
    }
  }

  # The original started the looping thrust sample on every throttle-up and
  # stopped it at each of the half-dozen places the engine could cut out; one
  # call a frame keeps the looping music slot in step with the throttle
  # instead.
  sync_thrust() {
    let on = self.mode == Mode.Playing && self.playing && self.ship.throttle > 0
    return if on == self.thrusting
    self.thrusting = on
    on ? Canvas.music(thrust, loop: true) : Canvas.music_stop()
  }

  draw() {
    Canvas.clear(BLACK)
    match self.mode {
      m: Menu => self.draw_menu(),
      m: Playing => self.draw_play(),
      m: Over => self.draw_over(),
    }
  }

  # No physics, just noise1d off the frame counter: a wandering drift and
  # bob, a slight tilt either way, and a flickering flame so it reads as
  # hovering under its own thrust rather than just drifting. Each channel
  # reads its own noise stream (seeds 1-4) at its own speed, so they never
  # fall into the same rhythm the way sines at unrelated frequencies still
  # eventually do.
  animate_menu_ship() {
    let t = to_float(self.fc) * DT
    let s = self.menu_ship
    s.x = WIDTH / 2.0 + noise1d(1, t * 0.25) * MENU_SHIP_DRIFT
    s.y = MENU_SHIP_Y + noise1d(2, t * 0.35) * MENU_SHIP_BOB
    s.ang = UPRIGHT + noise1d(3, t * 0.3) * MENU_SHIP_TILT
    s.throttle = Math.clamp(3 + Math.round(noise1d(4, t * 0.8) * 3.0), 1, 6)
  }

  # The title, the prompt and the Controls block, together, span from the
  # title's own top to the last Controls line's bottom -- 324 px at these
  # sizes and gaps, one Controls line more than the original's four. Drawn at
  # their original offsets that span sits well below HEIGHT / 2, so every y
  # below is that offset less 102, which slides the block up until its own
  # midpoint lands on HEIGHT / 2 instead.
  draw_menu() {
    if self.confirming_quit {
      block_centered(QUIT_CONFIRM, HEIGHT / 2 - 15, TEXT)
      return
    }
    text_centered("LUNAR LANDER", HEIGHT / 2 - 162, TITLE)
    text_centered("Press P to play, D to watch a demo", HEIGHT / 2 - 52, TEXT)
    block_centered(CONTROLS, HEIGHT / 2 + 18, TEXT)
    self.menu_ship.draw()
  }

  draw_play() {
    self.draw_world()
    if self.confirming_menu {
      block_centered(MENU_CONFIRM, HEIGHT / 2 - 15, TEXT)
      return
    }
    return if self.collided == lander.Hit.Clear

    # The outcome stays on screen for four seconds, then the next life starts.
    let message = cond {
      self.collided == lander.Hit.Crash => CRASHED,
      self.landing == Landing.Good => GOOD_LANDING,
      self.landing == Landing.Hard => HARD_LANDING,
      _ => CRASHED,
    }
    block_centered(message, HEIGHT / 2 - 30, TEXT)
    self.schedule(Timer.NextLife, 4.0)
  }

  draw_over() {
    self.draw_world()
    block_centered(NO_FUEL, HEIGHT / 2 - 30, TEXT)
    self.schedule(Timer.ToMenu, 5.0)
  }

  draw_world() {
    self.ship.draw()
    self.terrain.draw(text_at)
    let s = self.ship
    stats(
      LEFT_HUD_X,
      [("SCORE", self.score), ("FUEL", to_long(s.gas))],
      value_dx: LEFT_VALUE_DX,
    )
    # Vertical speed reads as a rate of climb, so a descent shows negative.
    stats(
      RIGHT_HUD_X,
      [
        ("ALTITUDE", to_long(to_float(HEIGHT - 10) - s.y)),
        ("HORIZONTAL SPEED", to_long(s.xvel)),
        ("VERTICAL SPEED", to_long(-s.yvel)),
      ],
      width: RIGHT_HUD_W,
    )
    # Between the two HUD columns, in the one strip of the top row neither
    # reaches: the player is watching rather than flying, and should be told.
    text_centered("DEMO", 40, HUD) if self.demo
  }
}

let frames = to_long(Sys.argv.get(1, "1200"))

# A demo run is seeded fixed so the same flight comes out every time.
Random.seed(DEMO ? 4 : Time.now().unix_nanos())
let game = Game(DEMO)
Canvas.title("Lunar Lander")
Canvas.run(WIDTH, HEIGHT, game.tick, frames: frames)

if DEMO {
  FS.write("shot.png", Canvas.to_png())
  println("score {game.score}, fuel {to_long(game.ship.gas)} after {game.fc} frames")
}
